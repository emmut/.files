// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "cmd-§": "terminal_panel::ToggleFocus",
      "ctrl-cmd-shift-alt-o": ["workspace::MoveItemToPaneInDirection", { "direction": "right" }]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-'": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "cmd-shift-l": "workspace::ToggleLeftDock",
      "cmd-l": "agent::AddSelectionToThread"
    }
  },
  {
    "bindings": {
      "cmd-k shift-right": "pane::SplitAndMoveRight"
    }
  },
  {
    "bindings": {
      "cmd-k left": "pane::SplitAndMoveLeft"
    }
  }
]
